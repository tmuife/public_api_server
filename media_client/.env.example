# Workspace settings
MEDIA_API_ACCESS_TOKEN=
WORK_DIR=./workdir
UPLOAD_DIR=./workdir/uploads

# Encryption key config
# Option A (recommended): derive AES-256 key from a human-friendly passphrase.
# Passphrase length is not limited by this app.
# Generate salt example:
# python - <<'PY'
# import base64, os
# print(base64.b64encode(os.urandom(16)).decode())
# PY
AES_256_GCM_PASSPHRASE=
AES_256_GCM_KDF_SALT_BASE64=
AES_256_GCM_KDF_ITERATIONS=600000

# Option B (legacy): provide raw 32-byte AES key in Base64 directly.
# python - <<'PY'
# import base64, os
# print(base64.b64encode(os.urandom(32)).decode())
# PY
AES_256_GCM_KEY_BASE64=

# Kafka connection
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092
KAFKA_SECURITY_PROTOCOL=SASL_SSL
KAFKA_SASL_MECHANISM=SCRAM-SHA-512
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
KAFKA_SSL_CA_FILE=/path/to/ca.pem

# Kafka runtime timeouts
KAFKA_PRODUCE_TIMEOUT_SECONDS=30
KAFKA_CONSUME_TIMEOUT_SECONDS=120

# Topic bootstrap defaults for dynamic job topics
KAFKA_TOPIC_PARTITIONS=1
KAFKA_TOPIC_REPLICATION_FACTOR=1

MEDIA_API_ACCESS_TOKEN=change-me

# Choose one AES mode:
AES_256_GCM_KEY_BASE64=
# AES_256_GCM_PASSPHRASE=
# AES_256_GCM_KDF_SALT_BASE64=
# AES_256_GCM_KDF_ITERATIONS=600000

KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_SASL_MECHANISM=SCRAM-SHA-512
# Producer/admin identity writes or creates *_output topics.
KAFKA_SASL_PRODUCER_USERNAME=
KAFKA_SASL_PRODUCER_PASSWORD=
# Consumer identity reads *_input topics and commits worker group offsets.
KAFKA_SASL_CONSUMER_USERNAME=
KAFKA_SASL_CONSUMER_PASSWORD=
# Legacy fallback for both producer/admin and consumer when split identities are not set:
# KAFKA_SASL_USERNAME=
# KAFKA_SASL_PASSWORD=
KAFKA_SSL_CA_FILE=

KAFKA_PRODUCE_TIMEOUT_SECONDS=30
KAFKA_WAIT_FIRST_FRAME_SECONDS=10
KAFKA_IDLE_TIMEOUT_SECONDS=3
KAFKA_MAX_PROCESS_SECONDS=120
KAFKA_TOPIC_PARTITIONS=1
KAFKA_TOPIC_REPLICATION_FACTOR=1

MEDIA_API_HOST=0.0.0.0
MEDIA_API_PORT=8000
